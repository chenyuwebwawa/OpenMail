# ===== OpenMail 环境配置示例 =====
# 复制为 .env 后按需修改；所有项均有默认值，开发环境零配置即可启动
#
# Docker / Docker Compose 部署：在仓库根目录执行 `cp .env.example .env`，
# docker-compose.yml 会通过 ${VAR:-默认值} 自动读取本文件中的变量
# （Compose 原生加载同目录 .env，无需 env_file）。

# ---- 基础 ----
OM_SITE_NAME=OpenMail
OM_BASE_URL=https://mail.example.com        # 对外访问地址（密码重置链接等会用到）
OM_PRIMARY_DOMAIN=example.com               # 主邮件域名（首次启动自动创建并生成 DKIM）
OM_DATA_DIR=data                            # SQLite 数据目录（Docker 部署请保持 data，对应 ./data 挂载）
OM_FILES_DIR=files                          # 附件存储目录（Docker 部署请保持 files，对应 ./files 挂载）

# ---- HTTP ----
# Docker 部署：容器内监听端口必须与 docker-compose.yml 的端口映射一致（默认 3000:3000）
OM_HTTP_PORT=3000
# HTTPS / TLS（可选）：配置 PEM 证书后启用 STARTTLS 与隐式 TLS；不配置则自动使用自签证书。
# 源码安装填宿主机路径（如 Let's Encrypt：/etc/letsencrypt/live/mail.example.com/fullchain.pem）；
# Docker 部署填容器内路径，需先把证书挂载进容器，例如 /certs/fullchain.pem。
OM_TLS_CERT=
OM_TLS_KEY=
# Docker 部署请保持 0：Web TLS 建议由 Nginx/Caddy 反代终结；或把证书挂载进容器后
# 用 OM_TLS_CERT / OM_TLS_KEY 填写容器内路径（如 /certs/fullchain.pem）。
OM_HTTPS_PORT=0                             # 0 = 关闭内置 HTTPS（生产建议由 Nginx/Caddy 反代）

# ---- SMTP / IMAP / POP3 端口（生产环境直接用标准端口）----
# Docker 部署：这些端口必须与 docker-compose.yml 的端口映射保持一致
#（默认 25/587/465/143/993/110/995，改这里也要改 compose 文件）
OM_SMTP_PORT=25                             # MX 服务器间收信
OM_SUBMISSION_PORT=587                      # 用户发信（SASL 认证）
OM_SMTPS_PORT=465                           # 隐式 TLS 发信
OM_IMAP_PORT=143
OM_IMAPS_PORT=993
OM_POP3_PORT=110
OM_POP3S_PORT=995
OM_SMTP_MAX_SIZE=26214400                   # 单封邮件上限（字节），默认 25MB
OM_MAX_MAILBOX_MB=1024                      # 新用户默认邮箱配额（MB）

# ---- 安全 ----
# 服务端密钥：用于加密已保存的 AI API Key（AES-256-GCM）。
# 留空 = 启动时自动生成并持久化到 data/secret.key（随 ./data 一起备份）。
# 生产也可固定一个值（openssl rand -hex 32）；注意之后修改它或删除 data/secret.key，
# 会导致已保存的 AI Key 无法解密（即失效，需要在管理后台重新填写）。
OM_SECRET=
OM_SESSION_TTL_HOURS=168                    # 会话有效期（小时）
OM_REGISTRATION=true                        # 是否开放自助注册
OM_ADMIN_EMAIL=admin@example.com            # 首次启动自动创建的管理员
OM_BCRYPT_ROUNDS=10

# ---- 站外投递中继（强烈建议生产配置）----
# 云厂商普遍封禁出站 25 端口；配置上游中继（如 Mailgun/SendGrid/ESP，或自有 smarthost）后走 587 投递。
# 不使用中继时以下保持为空即可（直连需服务器 25 出站可用）。
# 示例：OM_RELAY_HOST=smtp.sendgrid.net / OM_RELAY_PORT=587 / OM_RELAY_USER=apikey / OM_RELAY_PASS=SG.xxxx
OM_RELAY_HOST=
OM_RELAY_PORT=587
OM_RELAY_SECURE=false
OM_RELAY_USER=
OM_RELAY_PASS=

# ---- 反垃圾 ----
OM_ANTISPAM=true
OM_SPAM_SCORE=5                             # ≥ 此分进入垃圾邮件文件夹
OM_SPAM_REJECT=12                           # ≥ 此分在 SMTP 阶段拒收

OM_DKIM_SELECTOR=om1
